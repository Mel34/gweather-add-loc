# Maintainer: Your Name <your.email@example.com>

pkgname=gweather-add-loc
pkgver=0.1.0
pkgrel=1
pkgdesc="Add custom locations with arbitrary coordinates to GNOME Weather"
arch=('x86_64')
url="https://github.com/crian/gweather-add-loc"
license=('MIT')
depends=('gtk4' 'libadwaita' 'glibc')
makedepends=('cargo' 'git')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('3e0d31b45ae3eabd4c36c4fcb5a2e760669012da7dc3662b5bede6f30b8aa7ce')

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --release --locked
}

package() {
  cd "$pkgname-$pkgver"

  # Install the main GTK application binary
  install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"

  # Install the Bash script as an auxiliary tool
  install -Dm755 "gweather-add-loc.sh" "$pkgdir/usr/bin/gweather-add-loc.sh"

  # Install the desktop entry so the app appears in the application menu
  install -Dm644 "data/io.github.crian.GWeatherAddLoc.desktop" \
    "$pkgdir/usr/share/applications/io.github.crian.GWeatherAddLoc.desktop"

  # Install the application icons (installed as scalable SVGs)
  for icon in data/icons/hicolor/scalable/apps/*.svg; do
    install -Dm644 "$icon" \
      "$pkgdir/usr/share/icons/hicolor/scalable/apps/$(basename "$icon")"
  done

  # Install the license file
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
